        //Guardar
        function Guardar() {
         debugger;
            if (!$("#formNivel").valid()) {
                return;
            }

            var yyyy = $("#dtfechanac").val().substring(6, 10);
            var MM = $("#dtfechanac").val().substring(3, 5);
            var DD = $("#dtfechanac").val().substring(0, 2);
            var HH = $("#dtfechanac").val().substring(10, 12).trim();
            var mm = $("#dtfechanac").val().substring(13, 15).trim();
            var A = $("#dtfechanac").val().substring(19, 23).trim();
            if (HH.length == 1) { HH = '0' + HH; }

            if (mm.length == 1) { mm = '0' + mm; }

            var jsonModulo = {
                'datos': []
            };

            debugger;
            var selected = $("#id_label_multiple").select2("data");
            var selectedText = [];

            for (var i = 0; i < selected.length; i++) {
                selectedText.push(selected[i].text);
            }


            for (var i = 0; i < $("#id_label_multiple").val().length; i++) {
                jsonModulo.datos.push({
                    "idMicroEmprendedor": 0,
                    "idRubro": $("#id_label_multiple").val()[i],
                    "rubro":{
                            "id": $("#id_label_multiple").val()[i],
                        "descripcion": selectedText[i]//$("#id_label_multiple").text()
                    
                    }
                });
            };

            var jsonPalabraClave = {
                'datos': []
            };
            let palabras = $("#tags").val().split(",");

            for (var i = 0; i < palabras.length; i++) {
                jsonPalabraClave.datos.push({
                    "idMicroEmprendedor": 0,
                    "palabra": palabras[i],
                });
            };
            var json = JSON.stringify(jsonModulo);
            var obj =   JSON.parse(json);
            var jsonpc = JSON.stringify(jsonPalabraClave);
            var objpc = JSON.parse(jsonpc);
            var Microemprendedor = {
                id: $("#txtid").val(),
                apeyNom: $("#txtapeynom").val(),
                dni: $("#txtdni").val(),
                fechaNacimiento: moment(yyyy + "-" + MM + "-" + DD + "T" + HH + ":" + mm + ":" + A).format('YYYY-MM-DDT00:00:00'),
                idTipoDocumento: $("#cbotipodoc option:selected").val() == 0 ? null : $("#cbotipodoc option:selected").val(),
                tipoDocumento: {
                    id: $("#cbotipodoc option:selected").val() == 0 ? null : $("#cbotipodoc option:selected").val(),
                    descA: $("#cbotipodoc option:selected").text(),
                    descC: 'completa'
                },
                sexo: $('input:radio[name=sexo]')[0].checked == 0 ? "M" : "F",
                calle: $("#txtcalle").val(),
                nro: $("#txtnro").val(),
                piso: $("#txtpiso").val(),
                depto: $("#txtdepto").val(),
                idLocalidad: $("#cbolocalidadN option:selected").val() == 0 ? null : $("#cbolocalidadN option:selected").val(),
                localidad: {
                    id: $("#cbolocalidadN option:selected").val() == 0 ? null : $("#cbolocalidadN option:selected").val(),
                    descripcion: $("#cbolocalidadN option:selected").text(),
                    
                },
                //idRubro: $("#cborubro option:selected").val() == 0 ? null : $("#cborubro option:selected").val(),
                telFijo: $("#txttelfijo").val(),
                telCelular: $("#txttelcelular").val(),
                correo: $("#txtemail").val(),
                instagram: $("#txtinstagram").val(),
                facebook: $("#txtfacebook").val(),
                sitioWeb: $("#txtsitioweb").val(),
                observaciones: tinymce.get('taobservaciones').getContent(),
                rubros: obj.datos,
                palabrasClave: objpc.datos
            };
            debugger;
            console.log(Microemprendedor);
            jQuery.ajax({
                url: '@Url.Action("CreateMicroEmprendedor", "MicroEmprendedor")',
                type: "POST",
                data: JSON.stringify(Microemprendedor),
                contentType: 'application/json',
                success: function (data) {
                    $(".modal-body").LoadingOverlay("hide");
                    //  Microemprendedor nuevo
                    if (Microemprendedor.id == 0) {
                        if (data.resultado != 0) {
                            Microemprendedor.id = data.resultado;
                            console.log(Microemprendedor);
                            tabladata8.row.add(Microemprendedor).draw(false);
                            $("#FormModal").modal("hide");
                            agregarToast({ tipo: 'exito', titulo: 'Creando Microemprendedor', descripcion: 'Microemprendedor ingresado correctamente.', autoCierre: true });
                        }
                        else {
                            agregarToast({ tipo: 'error', titulo: 'Creando Microemprendedor', descripcion: data.mensaje, autoCierre: true });
                            $("#mensajeError").text(data.mensaje);
                            $("#mensajeError").show();
                        }
                    }
                    //  Microemprendedor Editar
                    else {

                        if (data.resultado) {
                            console.log(Microemprendedor);
                            tabladata8.row(filaSeleccionada).data(Microemprendedor).draw(false);
                            filaSeleccionada = null;
                            
                            agregarToast({ tipo: 'exito', titulo: 'Modificando Microemprendedor', descripcion: 'Microemprendedor modificado correctamente.', autoCierre: true });
                            $("#FormModal").modal("hide");
                            // mostrarAlert(data.mensaje)

                        } else {
                            agregarToast({ tipo: 'error', titulo: 'Modificando Microemprendedor', descripcion: data.mensaje, autoCierre: true });
                            $("#mensajeError").text(data.mensaje);
                            $("#mensajeError").show();
                        }
                    }
                },
                beforeSend: function () {
                    $(".modal-body").LoadingOverlay("show", {
                        imageResizeFactor: 2,
                        text: "Cargando...",
                        size: 14
                    });
                },
                error: function (error) {
                    $(".modal-body").LoadingOverlay("hide");
                    $("#mensajeError").text("Error Ajax");
                    $("#mensajeError").show();
                }
            }
            )
        }

